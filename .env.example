# OpenClaw Gateway Configuration
# Copy this file to .env and fill in your values

# Gateway URL (default: http://127.0.0.1:18789)
VITE_OPENCLAW_URL=http://127.0.0.1:18789

# Auth token from your OpenClaw config (gateway.auth.token in openclaw.json)
# NEVER commit this token to version control!
VITE_OPENCLAW_TOKEN=your_token_here

# OpenAI API Key for voice features (Whisper transcription & TTS)
# Get your key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key

# Voice model for voice mode conversations (default: openclaw:main)
# Use a faster model for lower latency voice interactions
# Examples: openclaw:haiku, gpt-4o-mini, claude-haiku-4
# This only affects messages sent via voice mode, not regular text chat
VITE_VOICE_MODEL=openclaw:main
